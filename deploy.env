# Non-secret defaults used by scripts/vps/deploy.sh.
# Environment variables passed to pnpm deploy:vps override these values.

DEPLOY_HOST="root@wangqiwen.me"
APP_NAME="wangqiwen-me"
SERVICE_USER="nextjs"
DOMAIN="wangqiwen.me"
SERVER_ALIASES="www.wangqiwen.me"
APP_HOST="127.0.0.1"
APP_PORT="3000"

# Caddy is shared with files.wangqiwen.me and frp.wangqiwen.me. Normal releases
# never touch it. First-time setup adds only this app's two site blocks and asks
# before replacing a conflicting block.
CADDY_OVERWRITE="ask"
