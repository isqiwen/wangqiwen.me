# Upstash Redis REST credentials.
# Get these from your Upstash project: create a Redis database in the Upstash
# console, then copy the REST URL and REST TOKEN from that database's details page.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="example-token"

# Optional IP geolocation API key used by app/api/geo/route.ts.
# Get this from ipgeolocation.io: create an account, then copy an API key from
# the dashboard / API Keys page.
GEO_IP_API_KEY=""
