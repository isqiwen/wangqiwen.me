  "pnpm": {
    "overrides": {
      "@babel/runtime": "7.29.7",
      "cross-spawn": "7.0.6",
      "dompurify": "3.4.16",
      "mdast-util-to-hast": "13.2.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "use-sync-external-store": "1.6.0",
      "fast-uri": "3.1.8",
      "source-map-js": "1.2.2"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "node scripts/content/build-site.cjs",
    "start": "next start",
    "lint": "eslint app content scripts tests utils mdx-components.ts middleware.tsx instrumentation.ts next.config.js --ext .js,.cjs,.mjs,.jsx,.ts,.tsx --no-error-on-unmatched-pattern",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx --test tests/smoke/*.test.ts",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e playwright test",
    "check:external-links": "tsx scripts/content/check-external-links.ts",
    "check": "pnpm sync:posts -- --check && pnpm lint:posts && pnpm lint && tsc --noEmit",
    "deploy:vps": "bash scripts/vps/deploy.sh",
    "new:post": "tsx scripts/content/new-post.ts",
    "sync:posts": "tsx scripts/content/sync-posts.ts",
    "lint:posts": "tsx scripts/content/lint-posts.ts",
    "backup:content": "node scripts/content/backup.cjs",
    "reset:content": "node scripts/content/reset.cjs",
    "postinstall": "node ./fonts/init.mjs"
  },
  "prettier": {
    "arrowParens": "avoid"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
